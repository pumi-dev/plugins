{
  "name": "pumi-marmaide",
  "displayName": "Marmaide",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Mermaid diagrams and charts.",
  "keywords": [
    "mermaid",
    "diagram",
    "diagrams",
    "flowchart",
    "sequence",
    "chart",
    "pele"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pumi-dev/plugins",
    "directory": "marmaide"
  },
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pele": "^1.8.0"
  },
  "pumi": {
    "name": "marmaide",
    "owner": "pumi_dev",
    "api": 1,
    "minPumi": "0.52.0",
    "uses": [
      "files"
    ],
    "contributes": {
      "options": {
        "font": {
          "type": "string",
          "default": "",
          "label": "Font",
          "placeholder": "the app's",
          "desc": "The diagram's text, by family. Empty is the app's own font."
        },
        "font_mono": {
          "type": "string",
          "default": "",
          "label": "Monospace font",
          "placeholder": "the app's",
          "desc": "What a diagram's code and constants are set in. Empty is the app's monospace font."
        },
        "font_size": {
          "type": "number",
          "default": 16,
          "min": 8,
          "max": 32,
          "step": 1,
          "unit": "px",
          "label": "Font size",
          "desc": "Pele lays a diagram out at this size."
        },
        "source": {
          "type": "string",
          "scope": "tab",
          "blocks": [
            "diagram"
          ],
          "default": "",
          "label": "Diagram source",
          "desc": "The Mermaid text this tab draws. `marmaide.draw` sets it; a new value is a new drawing."
        }
      },
      "blocks": [
        {
          "id": "diagram",
          "title": "Diagram",
          "icon": "list_tree",
          "audience": "agent"
        }
      ]
    },
    "activation": [
      "onStartup"
    ],
    "icon": "icon.png",
    "images": [
      {
        "path": "preview.svg",
        "alt": "A Mermaid diagram in a tab: three nodes and the edges between them, in the window's colours"
      }
    ]
  }
}
