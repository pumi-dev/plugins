#!/bin/sh
# marmaide — draw a Mermaid diagram in pumi, with Pele, from a shell.
#
# The plugin is `marmaide` (this package); this is the ergonomic half of it, over
# `pumi call`. The app must be open with the package on, and a JavaScript runtime
# (`bun` or `node`) somewhere the plugin can find it.
#
#   marmaide draw [FILE…]        show a diagram in a pane beside this one (stdin if no FILE)
#   marmaide draw --pane 7 [F…]  redraw pane 7 — the diagram in it is replaced, not doubled
#   marmaide svg [FILE…]         print the diagram's SVG (Pele's own: themeable anywhere)
#   marmaide save OUT [FILE…]    write it to OUT — .svg (themeable anywhere) or .png — and
#                                print where it went
#   marmaide size [FILE…]        the kind of diagram and its size, as drawn
#   marmaide types               what Mermaid this Pele draws
#
# FILE may be `-` for stdin. A diagram is Mermaid text:
#
#   marmaide draw <<'MMD'
#   flowchart LR
#     ask --> marmaide --> eyes
#   MMD

set -eu

usage() {
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

command="${1:-}"
[ -n "$command" ] || usage 1
shift || true

pane=""
if [ "$command" = "draw" ] && [ "${1:-}" = "--pane" ]; then
    pane="${2:-}"
    shift 2 || true
    [ -n "$pane" ] || { echo "marmaide: --pane needs a pane id" >&2; exit 1; }
fi

# The diagram: every FILE in order (so `-` and a file mix), or stdin.
source_text() {
    if [ "$#" -eq 0 ]; then
        cat
    else
        for file in "$@"; do
            if [ "$file" = "-" ]; then cat; else cat "$file"; fi
        done
    fi
}

json() {
    # json KEY VALUE… — a one-field object, quoted by whoever is here.
    if command -v jq >/dev/null 2>&1; then
        jq -n --arg value "$1" '{source: $value}'
    else
        python3 -c 'import json,sys; print(json.dumps({"source": sys.argv[1]}))' "$1"
    fi
}

field() {
    # field NAME — one string out of the answer on stdin.
    if command -v jq >/dev/null 2>&1; then
        jq -r --arg name "$1" '.[$name] // empty'
    else
        python3 -c 'import json,sys; print(json.load(sys.stdin).get(sys.argv[1], ""))' "$1"
    fi
}

case "$command" in
    draw|show|open)
        text="$(source_text "$@")"
        if [ -n "$text" ]; then
            request="$(json "$text")"
        else
            echo "marmaide: no diagram to draw" >&2
            exit 1
        fi
        if [ -n "$pane" ]; then
            request="$(printf '%s' "$request" | sed "s/^{/{\"pane\":$pane,/")"
        fi
        pumi call marmaide.draw "$request"
        ;;
    svg)
        text="$(source_text "$@")"
        pumi call marmaide.render "$(json "$text")" | field svg
        ;;
    save)
        out="${1:-}"
        [ -n "$out" ] || usage 1
        shift
        text="$(source_text "$@")"
        request="$(json "$text")"
        if command -v jq >/dev/null 2>&1; then
            request="$(printf '%s' "$request" | jq --arg path "$out" '. + {path: $path}')"
        else
            request="$(python3 -c 'import json,sys; print(json.dumps({"source": json.loads(sys.argv[1])["source"], "path": sys.argv[2]}))' "$request" "$out")"
        fi
        pumi call marmaide.save "$request"
        ;;
    size)
        text="$(source_text "$@")"
        pumi call marmaide.render "$(json "$text")" | jq -r '"\(.type) · \(.width|floor)×\(.height|floor)"' 2>/dev/null ||
            pumi call marmaide.render "$(json "$text")"
        ;;
    types)
        cat <<'TYPES'
flowchart · graph       process, decisions, structure        flowchart LR
sequenceDiagram         messages between parts over time     sequenceDiagram
classDiagram            types and their relations            classDiagram
stateDiagram-v2         states and the moves between them    stateDiagram-v2
erDiagram               entities and their keys             erDiagram
gantt                   a schedule                          gantt
pie / quadrantChart     proportions                         pie title Where it goes
mindmap                 a subject and its branches          mindmap
timeline                events in order                     timeline
journey                 an experience, step by step         journey
gitGraph                branches and merges                 gitGraph
sankey / block / radar  flows, blocks, scores               sankey-beta
TYPES
        ;;
    -h|--help|help)
        usage 0
        ;;
    *)
        echo "marmaide: no command $command" >&2
        usage 1
        ;;
esac
