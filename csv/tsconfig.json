{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "pumi": [
        "./node_modules/@pumid/types/index.ts"
      ],
      "pumi/jsx-runtime": [
        "./node_modules/@pumid/types/jsx-runtime.ts"
      ],
      "pumi/jsx-dev-runtime": [
        "./node_modules/@pumid/types/jsx-dev-runtime.ts"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "pumi"
  },
  "exclude": [
    "node_modules",
    "page",
    "web"
  ]
}
