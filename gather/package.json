{
  "name": "pumi-gather",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "description": "Gather as a UI theme: the window is a pixel-art office \u2014 wood floors, carpeted rooms for panes, agents as avatars with name tags.",
  "type": "module",
  "scripts": {
    "art": "bun tools/art.ts",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  },
  "pumi": {
    "name": "gather",
    "owner": "amresyd",
    "api": 1,
    "themes": [
      "themes/gather"
    ],
    "contributes": {
      "options": {
        "appearance": {
          "type": "string",
          "default": "system",
          "label": "Mode",
          "desc": "Light, dark, or follow the system.",
          "choices": [
            "system",
            "light",
            "dark"
          ],
          "labels": [
            "System",
            "Light",
            "Dark"
          ]
        }
      }
    }
  }
}
