{
  "name": "pumi-video-editor",
  "displayName": "Video Editor",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "description": "Edit a video in a tab: Clipkit's timeline editor over a project file (CKP/1.0 JSON) that an agent can write too. Saved on every edit, reloaded when the file changes.",  "keywords": [
    "video",
    "editor",
    "timeline",
    "clipkit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pumi-dev/plugins",
    "directory": "video-editor"
  },
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "tsc --noEmit && tsc --noEmit -p page"
  },
  "dependencies": {
    "@clipkit/editor": "1.2.0",
    "@clipkit/protocol": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  },
  "pumi": {
    "name": "video-editor",
    "owner": "pumi_dev",
    "api": 1,
    "uses": [
      "files",
      "network"
    ],
    "contributes": {
      "options": {
        "project": {
          "type": "string",
          "scope": "tab",
          "blocks": [
            "editor"
          ],
          "label": "Project",
          "desc": "The project file this tab edits: a Clipkit Source (CKP/1.0 JSON)."
        }
      },
      "blocks": [
        {
          "id": "editor",
          "title": "Video Editor",
          "icon": "plugin:icon.svg"
        }
      ]
    },
    "activation": [
      "onStartup"
    ]
  }
}
