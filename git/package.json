{
  "name": "pumi-git",
  "displayName": "Git",
  "version": "0.1.2",
  "license": "GPL-3.0-or-later",
  "description": "Git in the sidebar: stage, commit, history and diffs.",
  "keywords": [
    "git",
    "source-control",
    "diff",
    "history",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pumi-dev/plugins",
    "directory": "git"
  },
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "pumi": {
    "name": "git",
    "owner": "pumi_dev",
    "api": 1,
    "minPumi": "0.52.0",
    "icon": "icon.png",
    "images": [
      {
        "path": "preview.svg",
        "alt": "The git panel with staged files, changes and history, beside a diff in a tab"
      }
    ],
    "uses": [
      "files",
      "processes"
    ],
    "contributes": {
      "options": {
        "date_format": {
          "type": "string",
          "default": "relative",
          "choices": [
            "relative",
            "absolute"
          ],
          "labels": [
            "How long ago",
            "Date and time"
          ],
          "label": "Dates",
          "group": "Git",
          "desc": "How the history dates a commit: how long ago it was, or the day and minute it was."
        },
        "show_author": {
          "type": "boolean",
          "default": true,
          "label": "Authors",
          "group": "Git",
          "desc": "Show each commit's author in the history."
        },
        "diff": {
          "type": "string",
          "default": "",
          "scope": "tab",
          "label": "Diff",
          "group": "Git",
          "desc": "What a diff tab shows, as the page set it: a side of the work tree, a file of it, or a commit."
        }
      },
      "commands": [
        {
          "id": "toggle",
          "title": "Git: show the changes and the history"
        }
      ],
      "keys": [
        {
          "key": "<C-S-g>",
          "command": "toggle"
        }
      ],
      "slots": {
        "panel": {
          "component": "Git",
          "title": "Git",
          "icon": "git_branch"
        }
      },
      "blocks": [
        {
          "id": "diff",
          "title": "Diff",
          "icon": "git_branch",
          "audience": "internal"
        }
      ]
    },
    "activation": [
      "onStartup"
    ]
  },
  "dependencies": {
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@lezer/common": "1.5.4",
    "@lezer/highlight": "1.2.5"
  }
}
