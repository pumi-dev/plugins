{
  "name": "pumi-perf",
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "description": "How the app is doing, floating in a corner of the window: CPU, memory, frames, core plugins and the busiest threads.",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "pumi": {
    "name": "perf",
    "owner": "amresyd",
    "api": 1,
    "uses": [
      "processes",
      "files"
    ],
    "contributes": {
      "options": {
        "trigger": {
          "type": "string",
          "default": "<D-M-p>",
          "label": "Trigger",
          "group": "Performance overlay",
          "placeholder": "<D-M-p>",
          "desc": "The key that shows and hides the overlay, from anywhere. Cmd-Alt-P by default."
        },
        "corner": {
          "type": "string",
          "default": "NE",
          "choices": [
            "NE",
            "NW",
            "SE",
            "SW"
          ],
          "labels": [
            "Top right",
            "Top left",
            "Bottom right",
            "Bottom left"
          ],
          "label": "Corner",
          "group": "Performance overlay",
          "desc": "The corner of the window it floats in."
        }
      },
      "commands": [
        {
          "id": "toggle",
          "title": "Toggle the performance overlay"
        }
      ],
      "blocks": [
        {
          "id": "overlay",
          "title": "Performance Overlay",
          "icon": "zap"
        }
      ]
    },
    "activation": [
      "onStartup"
    ]
  }
}
