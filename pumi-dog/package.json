{
  "name": "pumi-dog",
  "version": "0.3.0",
  "description": "A little pumi in the side bar: it walks its track, stops to wag and blink, and barks when you click it.",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "pumi": {
    "name": "pumi-dog",
    "owner": "amresyd",
    "api": 1,
    "contributes": {
      "options": {
        "speed": {
          "type": "number",
          "default": 8,
          "min": 2,
          "max": 16,
          "step": 1,
          "unit": "fps",
          "label": "Speed",
          "control": "slider",
          "group": "Pumi dog",
          "desc": "Animation frames per second. Lower is calmer and cheaper."
        },
        "track": {
          "type": "number",
          "default": 140,
          "min": 40,
          "max": 600,
          "unit": "px",
          "label": "Walking room",
          "group": "Pumi dog",
          "desc": "How far along its side bar section the dog walks."
        },
        "size": {
          "type": "number",
          "default": 20,
          "min": 12,
          "max": 32,
          "step": 1,
          "unit": "px",
          "label": "Size",
          "control": "slider",
          "group": "Pumi dog",
          "desc": "The dog's height."
        }
      },
      "commands": [
        {
          "id": "toggle",
          "title": "Pumi dog: take it away, or bring it back"
        }
      ],
      "slots": {
        "panel": {
          "component": "Dog",
          "title": "Pumi dog",
          "icon": "sparkle"
        }
      }
    },
    "activation": [
      "onStartup"
    ]
  }
}
