{
  "name": "pumi-dia",
  "version": "0.1.0",
  "description": "Dia as a UI theme: one frosted sidebar of pinned tiles, folders and tabs, the panes on a card beside it.",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "pumi": {
    "name": "dia",
    "owner": "amresyd",
    "api": 1,
    "themes": [
      "themes/dia"
    ],
    "contributes": {
      "options": {
        "appearance": {
          "type": "string",
          "default": "system",
          "label": "Mode",
          "desc": "Light, dark, or follow the system.",
          "choices": [
            "system",
            "light",
            "dark"
          ],
          "labels": [
            "System",
            "Light",
            "Dark"
          ]
        }
      }
    }
  }
}
