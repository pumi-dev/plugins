        "program": "cursor-agent",
        "rank": 70,
        "icon": "icon.svg",
        "hook": {
          "shape": {
            "kind": "cursor",
            "file": ".cursor/hooks.json"
          },
          "restore": ["cursor-agent", "--resume", "{session}"]
        }
      }
    ]
  }
}
