{
  "name": "pumi-attention",
  "version": "0.2.0",
  "license": "GPL-3.0-or-later",
  "description": "Says so when an agent is blocked and you are looking elsewhere; @attention counts them.",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "pumi": {
    "name": "attention",
    "owner": "amresyd",
    "api": 1,
    "contributes": {
      "options": {
        "bounce": {
          "type": "string",
          "default": "once",
          "choices": [
            "none",
            "once",
            "until_focus"
          ],
          "desc": "Bounce the Dock icon when an agent is blocked and the app is in the background."
        },
        "badge": {
          "type": "boolean",
          "default": false,
          "desc": "Badge the icon with how many agents are blocked."
        }
      }
    },
    "activation": [
      "onStartup"
    ]
  }
}
