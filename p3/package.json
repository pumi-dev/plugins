{
  "name": "pumi-p3",
  "version": "0.1.0",
  "description": "P3 as a UI theme, after T3 Code: a quiet graphite window, every tab a thread in the side bar under its project, a breadcrumb over flat panes.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  },
  "pumi": {
    "name": "p3",
    "owner": "amresyd",
    "api": 1,
    "themes": [
      "themes/p3"
    ],
    "contributes": {
      "options": {
        "appearance": {
          "type": "string",
          "default": "dark",
          "label": "Mode",
          "desc": "Graphite at night, paper by day, or follow the system.",
          "choices": [
            "system",
            "light",
            "dark"
          ],
          "labels": [
            "System",
            "Light",
            "Dark"
          ]
        }
      }
    }
  }
}
