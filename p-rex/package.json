{
  "name": "pumi-p-rex",
  "version": "0.1.0",
  "description": "P-Rex as a UI theme: frosted violet glass over the desktop, tabs as a list down the side, every pane a card of its own.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  },
  "pumi": {
    "name": "p-rex",
    "owner": "amresyd",
    "api": 1,
    "themes": [
      "themes/p-rex"
    ],
    "contributes": {
      "options": {
        "appearance": {
          "type": "string",
          "default": "dark",
          "label": "Mode",
          "desc": "Violet glass at night, lilac glass by day, or follow the system.",
          "choices": [
            "system",
            "light",
            "dark"
          ],
          "labels": [
            "System",
            "Light",
            "Dark"
          ]
        }
      }
    }
  }
}
