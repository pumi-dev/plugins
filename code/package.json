{
  "name": "pumi-code",
  "version": "0.1.0",
  "description": "A native code editor for file tabs, written in TSX: CodeMirror's state, parsers and commands, drawn by pumi's renderer with no web page.",
  "type": "module",
  "main": "src/main.ts",
  "keywords": [
    "editor",
    "code"
  ],
  "scripts": {
    "vendor": "bun scripts/vendor.ts",
    "test": "bun test",
    "check": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@lezer/common": "1.5.4",
    "@lezer/highlight": "1.2.5",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "pumi": {
    "name": "code",
    "owner": "amresyd",
    "api": 1,
    "contributes": {
      "options": {
        "dirty": {
          "type": "boolean",
          "scope": "tab",
          "default": false,
          "blocks": [
            "file"
          ],
          "label": "Unsaved",
          "group": "Code editor",
          "desc": "Whether the file tab's file has changes not saved yet. The editor sets it; setting it does nothing."
        },
        "tab_size": {
          "type": "number",
          "default": 4,
          "min": 1,
          "max": 16,
          "step": 1,
          "label": "Tab size",
          "group": "Code editor",
          "desc": "How many columns a tab is, and an indent for a file whose own indentation says nothing."
        },
        "insert_spaces": {
          "type": "boolean",
          "default": true,
          "label": "Indent with spaces",
          "group": "Code editor",
          "desc": "Indent with spaces rather than a tab, for a file whose own indentation says nothing."
        }
      },
      "commands": [
        {
          "id": "save",
          "title": "Code editor: save"
        }
      ],
      "keys": [
        {
          "key": "<D-s>",
          "command": "save"
        }
      ],
      "slots": {
        "tab.toolbar": {
          "component": "Toolbar"
        }
      },
      "renderers": {
        "file": {
          "export": "Editor",
          "match": [
            "*.js",
            "*.mjs",
            "*.cjs",
            "*.jsx",
            "*.ts",
            "*.mts",
            "*.cts",
            "*.tsx",
            "*.json",
            "*.jsonc",
            "*.rs",
            "*.py",
            "*.pyi",
            "*.go",
            "*.c",
            "*.h",
            "*.cc",
            "*.cpp",
            "*.cxx",
            "*.hpp",
            "*.hh",
            "*.m",
            "*.mm",
            "*.java",
            "*.css",
            "*.html",
            "*.htm",
            "*.md",
            "*.markdown",
            "*.yaml",
            "*.yml"
          ]
        }
      }
    },
    "activation": [
      "onStartup"
    ]
  }
}
