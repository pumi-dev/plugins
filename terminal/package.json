{
  "name": "pumi-terminal",
  "displayName": "Terminal",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "description": "A shell in a tab. pumi runs the terminal (its program, its screen, its scrollback, across restarts); this plugin is the block a tab opens it in, and draws it.",
  "keywords": [
    "terminal",
    "shell"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pumi-dev/plugins",
    "directory": "terminal"
  },
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "pumi": {
    "name": "terminal",
    "owner": "pumi_dev",
    "api": 1,
    "minPumi": "0.44.0",
    "contributes": {
      "commands": [
        {
          "id": "open",
          "title": "Terminal: new terminal"
        }
      ],
      "blocks": [
        {
          "id": "shell",
          "title": "Terminal",
          "icon": "terminal",
          "engine": "terminal"
        }
      ],
      "slots": {
        "tab.new": {
          "actions": [
            {
              "id": "open",
              "title": "Terminal",
              "icon": "terminal",
              "command": "open"
            }
          ]
        }
      }
    },
    "activation": [
      "onStartup"
    ]
  }
}
