{
  "_": "Heeler's SSH runs, as pumi's shell hands them to a plugin: argv is the shell's own words, already expanded (\"$1\", $HOME, $(...) done), and command is those quoted back into a line. The node answers $HOME, test -S, command -v and PATH exports itself (docs/plan/ssh-machine.md), so those never arrive here.",
  "sessionList": {
    "command": "herdr session list --json",
    "argv": [
      "herdr",
      "session",
      "list",
      "--json"
    ]
  },
  "bridgeCheck": {
    "command": "herdr remote-api-bridge --check",
    "argv": [
      "herdr",
      "remote-api-bridge",
      "--check"
    ]
  },
  "bridgeClient": {
    "command": "HERDR_SOCKET_PATH=/Users/me/.config/herdr/sessions/pumi/herdr.sock /Users/me/.local/bin/herdr remote-client-bridge --remote-keybindings local",
    "argv": [
      "/Users/me/.local/bin/herdr",
      "remote-client-bridge",
      "--remote-keybindings",
      "local"
    ],
    "env": {
      "HERDR_SOCKET_PATH": "/Users/me/.config/herdr/sessions/pumi/herdr.sock"
    }
  },
  "windows": {
    "command": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
    "argv": [
      "powershell.exe",
      "-NoLogo",
      "-NoProfile",
      "-NonInteractive",
      "-EncodedCommand",
      ""
    ]
  }
}
