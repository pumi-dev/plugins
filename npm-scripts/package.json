{
  "name": "pumi-npm-scripts",
  "version": "0.3.0",
  "description": "A page in the left sidebar of every package.json script in the current repository, workspaces included, each run in a terminal with the package's own manager.",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "script-panel": "file:../lib/script-panel"
  },
  "pumi": {
    "name": "npm-scripts",
    "owner": "amresyd",
    "api": 1,
    "uses": [
      "files",
      "processes"
    ],
    "contributes": {
      "options": {
        "show_command": {
          "type": "boolean",
          "default": true,
          "label": "Commands",
          "group": "NPM Scripts",
          "desc": "Show what each script runs, beside its name."
        },
        "sort": {
          "type": "string",
          "default": "path",
          "choices": [
            "path",
            "scripts"
          ],
          "labels": [
            "Path",
            "Most scripts first"
          ],
          "label": "Order packages by",
          "group": "NPM Scripts",
          "desc": "How the package.json files are listed."
        },
        "max_depth": {
          "type": "number",
          "default": 4,
          "min": 1,
          "max": 10,
          "step": 1,
          "label": "Depth",
          "group": "NPM Scripts",
          "desc": "How many directories below the repository root to look in."
        }
      },
      "points": {
        "panel": {
          "view": "Scripts",
          "title": "NPM Scripts",
          "icon": "package"
        }
      }
    }
  }
}
