[
 {
  "name": "pumi_cmd",
  "since": 1,
  "provider": "tmux",
  "runs_on": "server",
  "effect": "write",
  "agent": true,
  "desc": "Run commands (Neovim's `nvim_cmd`, tmux's command line): a string in tmux's language\n(`\"split-pane -h ; select-pane -L\"`), or `pumi_parse_cmd`'s tables. Returns what they printed.\nA command that waits (`run-shell`, `wait-for`, `new-pane -W`) holds the reply until it ends.",
  "parameters": [
   [
    "Object",
    "cmd"
   ],
   [
    "Dict",
    "opts"
   ]
  ],
  "params_schema": {
   "$defs": {
    "CmdOpts": {
     "additionalProperties": false,
     "description": "Where and how a command line runs.",
     "properties": {
      "cwd": {
       "default": null,
       "description": "The directory relative paths are in: the CLI's.",
       "type": [
        "string",
        "null"
       ]
      },
      "pane": {
       "default": null,
       "description": "The pane it is about, as if run from there.",
       "format": "uint64",
       "minimum": 0,
       "type": [
        "integer",
        "null"
       ]
      },
      "vars": {
       "additionalProperties": {
        "type": "string"
       },
       "default": {},
       "description": "Format variables for it (`hook_pane`, \u2026).",
       "type": "object"
      }
     },
     "type": "object"
    },
    "CmdResult": {
     "description": "What a command line printed, and the status of a program it waited for (`wait-pane`,\n`new-pane -W`).",
     "properties": {
      "output": {
       "type": "string"
      },
      "status": {
       "format": "int32",
       "type": [
        "integer",
        "null"
       ]
      },
      "waiting": {
       "description": "The call returned before the commands ended (it was made inside another call).",
       "type": "boolean"
      }
     },
     "required": [
      "output"
     ],
     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "cmd": true,
    "opts": {
     "anyOf": [
      {
       "$ref": "#/$defs/CmdOpts"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "cmd"
   ],
   "type": "object"
  },
  "returns": "Dict",
  "returns_schema": {
   "$defs": {
    "CmdOpts": {
     "additionalProperties": false,
     "description": "Where and how a command line runs.",
     "properties": {
      "cwd": {
       "default": null,
       "description": "The directory relative paths are in: the CLI's.",
       "type": [
        "string",
        "null"
       ]
      },
      "pane": {
       "default": null,
       "description": "The pane it is about, as if run from there.",
       "format": "uint64",
       "minimum": 0,
       "type": [
        "integer",
        "null"
       ]
      },
      "vars": {
       "additionalProperties": {
        "type": "string"
       },
       "default": {},
       "description": "Format variables for it (`hook_pane`, \u2026).",
       "type": "object"
      }
     },
     "type": "object"
    },
    "CmdResult": {
     "description": "What a command line printed, and the status of a program it waited for (`wait-pane`,\n`new-pane -W`).",
     "properties": {
      "output": {
       "type": "string"
      },
      "status": {
       "format": "int32",
       "type": [
        "integer",
        "null"
       ]
      },
      "waiting": {
       "description": "The call returned before the commands ended (it was made inside another call).",
       "type": "boolean"
      }
     },
     "required": [
      "output"
     ],
     "type": "object"
    }
   },
   "$ref": "#/$defs/CmdResult"
  },
  "examples": [
   {
    "args": [
     "display-message -p '#{session_name}'",
     {}
    ],
    "result": {
     "output": "main\n",
     "status": null
    }
   },
   {
    "args": [
     {
      "cmd": "split-pane",
      "flags": {
       "h": true,
       "l": "30%"
      }
     },
     {}
    ],
    "result": {
     "output": "",
     "status": null
    },
    "desc": "A table, as pumi_parse_cmd gives it."
   }
  ],
  "source": "tmux"
 },
 {
  "name": "pumi_create_user_command",
  "since": 1,
  "provider": "tmux",
  "runs_on": "server",
  "effect": "write",
  "agent": true,
  "desc": "Create a user command (Neovim's `nvim_create_user_command`): its name is Capitalised, so it\nnever collides with a built-in. `command` is a command line, with `<args>`, `<q-args>`,\n`<f-args>` and `<bang>` replaced; a Lua function, called with `{name, args, fargs, bang}`;\nor `null` with `opts.call` naming a function.",
  "parameters": [
   [
    "String",
    "name"
   ],
   [
    "Object",
    "command"
   ],
   [
    "Dict",
    "opts"
   ]
  ],
  "params_schema": {
   "$defs": {
    "CommandBody": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "$ref": "#/$defs/LuaRef"
      }
     ],
     "description": "What a user command runs: a command line, or a Lua function (`{\"luaref\": n}`, which the\nhost holds: from Lua, the host turns it into `opts.callback`)."
    },
    "LuaRef": {
     "additionalProperties": false,
     "description": "A Lua function the host's VM keeps.",
     "properties": {
      "luaref": {
       "format": "uint64",
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "luaref"
     ],
     "type": "object"
    },
    "UserCommandOpts": {
     "additionalProperties": false,
     "properties": {
      "call": {
       "default": null,
       "description": "The function it calls instead of a command line; its flags are the function's parameters\n(`--name value`, `name=value`, or in order).",
       "type": [
        "string",
        "null"
       ]
      },
      "callback": {
       "default": null,
       "description": "The function it calls with `{name, args, fargs, bang}`, as Neovim calls a Lua callback\n(the host makes one of a Lua function given as `command`).",
       "type": [
        "string",
        "null"
       ]
      },
      "desc": {
       "default": null,
       "type": [
        "string",
        "null"
       ]
      },
      "force": {
       "default": null,
       "description": "Replace a command of that name (Neovim's `force`, `true` by default).",
       "type": [
        "boolean",
        "null"
       ]
      },
      "nargs": {
       "default": null,
       "description": "How many arguments it takes: `0` (the default), `1`, `*`, `?` or `+` (Neovim's)."
      }
     },
     "type": "object"
    }
   },
   "additionalProperties": false,
   "properties": {
    "command": {
     "anyOf": [
      {
       "$ref": "#/$defs/CommandBody"
      },
      {
       "type": "null"
      }
     ]
    },
    "name": {
     "type": "string"
    },
    "opts": {
     "anyOf": [
      {
       "$ref": "#/$defs/UserCommandOpts"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "name"
   ],
   "type": "object"
  },
  "returns": "nil",
  "returns_schema": {
   "$defs": {
    "CommandBody": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "$ref": "#/$defs/LuaRef"
      }
     ],
     "description": "What a user command runs: a command line, or a Lua function (`{\"luaref\": n}`, which the\nhost holds: from Lua, the host turns it into `opts.callback`)."
    },
    "LuaRef": {
     "additionalProperties": false,
     "description": "A Lua function the host's VM keeps.",
     "properties": {
      "luaref": {
       "format": "uint64",
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "luaref"
     ],
     "type": "object"
    },
    "UserCommandOpts": {
     "additionalProperties": false,
     "properties": {
      "call": {
       "default": null,
       "description": "The function it calls instead of a command line; its flags are the function's parameters\n(`--name value`, `name=value`, or in order).",
       "type": [
        "string",
        "null"
       ]
      },
      "callback": {
       "default": null,
       "description": "The function it calls with `{name, args, fargs, bang}`, as Neovim calls a Lua callback\n(the host makes one of a Lua function given as `command`).",
       "type": [
        "string",
        "null"
       ]
      },
      "desc": {
       "default": null,
       "type": [
        "string",
        "null"
       ]
      },
      "force": {
       "default": null,
       "description": "Replace a command of that name (Neovim's `force`, `true` by default).",
       "type": [
        "boolean",
        "null"
       ]
      },
      "nargs": {
       "default": null,
       "description": "How many arguments it takes: `0` (the default), `1`, `*`, `?` or `+` (Neovim's)."
      }
     },
     "type": "object"
    }
   },
   "type": "null"
  },
  "examples": [
   {
    "args": [
     "Build",
     "run-shell 'make <args>'",
     {
      "desc": "Run make.",
      "nargs": "*"
     }
    ]
   },
   {
    "args": [
     "Panes",
     null,
     {
      "call": "pumi_list_panes"
     }
    ],
    "desc": "A function as a command."
   }
  ],
  "source": "tmux"
 },
